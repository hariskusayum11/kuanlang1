# SKL-FRIS — Environment Example (committable)
# คัดลอกเป็น .env แล้วปรับค่าตามเครื่อง local — ห้าม commit .env จริง
# ค่าด้านล่างเป็น Development local เท่านั้น (ตรงกับ docker-compose.yml)
DATABASE_URL="postgresql://kuanlang:kuanlang_dev_password@localhost:5432/kuanlang_dev?schema=public"
DIRECT_URL="postgresql://kuanlang:kuanlang_dev_password@localhost:5432/kuanlang_dev?schema=public"

# Better Auth — สร้าง secret เอง เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Synthetic Development Test User (สร้างผ่าน: npm run auth:create-dev-user)
# ใช้ domain test.invalid เท่านั้น — ห้ามใช้บัญชี/ข้อมูลบุคคลจริง
DEV_AUTH_EMAIL=dev-admin@test.invalid
DEV_AUTH_PASSWORD=

# Dev RBAC (ผูกผ่าน: npm run auth:assign-dev-access) — local dev เท่านั้น
# DEV_AUTH_ROLE = ADMIN | EXECUTIVE | OFFICER | COORDINATOR | VERIFIER | VOLUNTEER | DATA_ENTRY | RESEARCHER | FIELD_SURVEYOR
# DEV_AUTH_COMMUNITIES = รหัสชุมชนคั่นด้วย comma เช่น TK01,PS01 (เว้นว่างได้สำหรับ global role)
DEV_AUTH_ROLE=
DEV_AUTH_COMMUNITIES=
