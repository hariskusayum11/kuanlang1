{
  "name": "skl-fris",
  "version": "0.1.0",
  "private": true,
  "description": "SKL-FRIS — Song Khlong Khuan Lang Flood Resilience Information System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "auth:create-dev-user": "node --env-file=.env --import tsx scripts/create-dev-user.ts",
    "auth:assign-dev-access": "node --env-file=.env --import tsx scripts/assign-dev-access.ts",
    "dev:create-batch": "node --env-file=.env --import tsx scripts/create-dev-batch.ts",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed.dev.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "password:reset": "tsx scripts/reset-user-password.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "better-auth": "1.6.23",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "next": "^16.2.11",
    "nodemailer": "^9.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "20.17.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.21",
    "prisma": "5.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
