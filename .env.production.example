# SKL-FRIS — Production/Test env (คัดลอกเป็น .env.production บน VPS แล้วเติมค่าจริง)
# ⚠️ ห้าม commit .env.production — มี secret จริง (.gitignore กัน .env.* ให้แล้ว)

# ---- Docker image ที่ push ขึ้น DockerHub ----
IMAGE=your-dockerhub-user/skl-fris:v1

# ---- PostgreSQL (ใช้โดย service db และประกอบเป็น DATABASE_URL ของ app) ----
POSTGRES_USER=skl
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=skl_fris

# host = "db" (ชื่อ service ใน compose) ไม่ใช่ localhost — app คุยกับ db ผ่าน network ภายใน
DATABASE_URL=postgresql://skl:replace-with-a-url-encoded-password@db:5432/skl_fris?schema=public

# ---- Better Auth ----
# secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# URL สาธารณะที่ผู้ทดสอบเปิด — ต้องตรงกับที่เข้าจริง (มิฉะนั้น cookie/redirect เพี้ยน)
# ยังไม่มีโดเมน/HTTPS ก็ใช้ IP ได้: http://<VPS_IP>:3000
BETTER_AUTH_URL=http://your-vps-ip:3000

# ---- SMTP (ยืนยันอีเมล + ลืมรหัสผ่าน) ----
# port 587 ใช้ STARTTLS: SMTP_SECURE=false / port 465: SMTP_SECURE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM="SKL-FRIS <noreply@example.com>"

# ---- Field-level encryption (Owner Decision R5) ----
# สร้างแยกกัน 2 ค่า: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ Key หาย = ข้อมูลที่เข้ารหัสไว้กู้ไม่ได้ถาวร — เก็บสำเนา offline อย่างน้อย 2 ชุด
DATA_ENCRYPTION_KEY=

SEARCH_HASH_KEY=

# ---- Seed ข้อมูลหลัก (จังหวัด/อำเภอ/ตำบล/ชุมชน/ตัวเลือกกระดาษ) ----
# ตั้ง true สำหรับ deploy รอบแรกให้ entrypoint seed ให้อัตโนมัติ (idempotent)
SEED_ON_START=true

# ---- Admin คนแรก (ใช้กับ scripts/create-admin.ts — ดู docs/deploy-v1.md) ----
# ไม่ได้ถูกอ่านโดย compose แต่ต้องใช้ตอนรัน bootstrap admin ครั้งเดียว
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=ผู้ดูแลระบบ
